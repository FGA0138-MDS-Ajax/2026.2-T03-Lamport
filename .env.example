# Variáveis do Docker Compose. Copie para .env (não versionado) e preencha SECRET_KEY.

# Chave de assinatura dos tokens JWT, com pelo menos 32 caracteres. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Senha do PostgreSQL do contêiner db (o usuário e o banco são "sintoniza").
POSTGRES_PASSWORD=sintoniza

# Porta do computador em que o site fica disponível: http://localhost:8080
WEB_PORT=8080
